# Copy to .env.local for local development. For the Cloudflare deploy the same names are GitHub
# Actions variables (docs/DEPLOY.md). Every VITE_ value ends up in the public browser bundle.

# Supabase project. Local: `supabase status -o env` (API_URL, ANON_KEY).
# Hosted: Dashboard > Project Settings > API Keys (Project URL, publishable or legacy anon key).
# Never put a secret/service_role key or database credentials in any VITE_ variable.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Path the site is served from: "/" (workers.dev address, custom domain, local dev).
VITE_BASE_PATH=/

# Public origin of the site, used in auth email redirect links (no trailing slash).
# Must match supabase/config.toml [auth] site_url / additional_redirect_urls (local dev: 127.0.0.1:5174).
VITE_SITE_URL=http://127.0.0.1:5174
