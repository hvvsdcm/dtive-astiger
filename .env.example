# Supabase project (Dashboard > Project Settings > API). Local: values printed by `supabase status -o env` (API_URL, ANON_KEY).
# Only the public anon/publishable key belongs here. Never put service_role or database credentials in any VITE_ variable.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Path the site is served from. "/" for a custom domain or local dev, "/<repo>/" for https://<user>.github.io/<repo>/
VITE_BASE_PATH=/

# Public origin of the site, used in auth email redirect links (no trailing slash).
# Must match supabase/config.toml [auth] site_url / additional_redirect_urls (local dev: 127.0.0.1:5174).
VITE_SITE_URL=http://127.0.0.1:5174
