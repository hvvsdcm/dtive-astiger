// Cloudflare Workers static assets only (no Worker script). Deployed by
// .github/workflows/deploy.yml after `npm run build`; setup in docs/DEPLOY.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dtive-astiger",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    // Unknown paths (/shop/women, …) get index.html with status 200 and the React router takes over.
    "not_found_handling": "single-page-application",
  },
}
